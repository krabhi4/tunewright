{
  "name": "tunewright-frontend",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "description": "Tunewright web frontend (SvelteKit SPA)",
  "license": "MIT",
  "repository": {
    "type": "git",
