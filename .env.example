# Tunewright Configuration

# Path to your music library on the host (used by docker-compose)
MUSIC_DIR=/path/to/your/music

# Directory containing your music files inside the container
TUNEWRIGHT_DATA_DIR=/data

# Web server settings
TUNEWRIGHT_PORT=8080
TUNEWRIGHT_HOST=0.0.0.0

# Authentication: first visitor creates admin account via web UI
# User data is stored in {TUNEWRIGHT_DATA_DIR}/users.json

# Optional: require a token to create the first admin account. Strongly
# recommended when the server is reachable by other machines before setup
# is complete (e.g. Docker binding 0.0.0.0).
# If unset and the server binds a non-loopback address, a token is generated
# at startup and printed to the log.
# TUNEWRIGHT_SETUP_TOKEN=choose-a-secret-value

# Set to true when serving over HTTPS so the session cookie gets Secure
# TUNEWRIGHT_COOKIE_SECURE=false

# Frontend static files location (set automatically in Docker)
# TUNEWRIGHT_STATIC_DIR=/srv/static
